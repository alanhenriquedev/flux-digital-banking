DATABASE_URL="postgresql://flux:flux123@localhost:5432/flux?schema=public"
JWT_SECRET="troque-por-uma-chave-segura-com-pelo-menos-32-caracteres"
JWT_EXPIRES_IN="7d"
PORT=3333
CORS_ORIGIN="http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,null"

# Desenvolvimento local (Mailpit via docker-compose)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="Flux <noreply@flux.local>"

# Produção: substitua os valores acima por um SMTP real.
# Gmail: smtp.gmail.com / 465 / true + senha de aplicativo.
# Gmail STARTTLS: smtp.gmail.com / 587 / false + senha de aplicativo.
# Nunca grave credenciais reais no repositório.

FRONTEND_URL=http://localhost:5500

EMAIL_VERIFY_EXPIRES_IN=24h

PASSWORD_RESET_EXPIRES_IN=30m

# Notificações de acesso (login). DESLIGADO por padrão.
NOTIFY_LOGIN=false
