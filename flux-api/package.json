    "test:devices:unit": "node --test test/devices.unit.cjs",
    "test:goals:unit": "node --test test/goals.unit.cjs",
    "test:alerts:unit": "node --test test/alerts.unit.cjs",
    "test:risk:unit": "node --test test/risk.unit.cjs",
    "test:mail:unit": "node --test test/mail.unit.cjs",
    "test:auth-email:unit": "node --test test/auth-email.unit.cjs",
    "test:notifications:unit": "node --test test/notifications.unit.cjs",
    "test:notifications:e2e": "node --test test/notifications.e2e.cjs",
    "test:security:e2e": "node --test test/security.e2e.cjs",
    "test:sessions:e2e": "node --test test/sessions.e2e.cjs",
    "test:devices:e2e": "node --test test/devices.e2e.cjs",
    "test:goals:e2e": "node --test test/goals.e2e.cjs",
    "test:alerts:e2e": "node --test test/alerts.e2e.cjs",
    "test:risk:e2e": "node --test test/risk.e2e.cjs",
    "test": "npm run build && npm run test:security:unit && npm run test:devices:unit && npm run test:goals:unit && npm run test:alerts:unit && npm run test:risk:unit && npm run test:mail:unit && npm run test:auth-email:unit && npm run test:notifications:unit && npm run test:security:e2e && npm run test:sessions:e2e && npm run test:devices:e2e && npm run test:goals:e2e && npm run test:alerts:e2e && npm run test:notifications:e2e && npm run test:risk:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
